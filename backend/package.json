{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "description": "REST API for Task Manager — Automated Testing & Deployment Pipeline",
  "main": "src/server.js",
  "scripts": {
    "start":   "node src/server.js",
    "dev":     "nodemon src/server.js",
    "test":    "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "keywords": ["nodejs", "express", "sqlite", "rest-api", "ci-cd"],
  "author": "Gurudev S",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.12.0",
    "cors":           "^2.8.5",
    "express":        "^4.18.3",
    "helmet":         "^7.1.0",
    "morgan":         "^1.10.0"
  },
  "devDependencies": {
    "jest":       "^29.7.0",
    "supertest":  "^6.3.4",
    "nodemon":    "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageReporters": ["text", "lcov", "html"]
  }
}
